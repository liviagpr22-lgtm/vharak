# Modelo de ambiente do backend da VHARAK.
# Copie para .env e troque os valores. O .env NAO entra no repositorio.

# Porta da API. O backend tambem serve o frontend como estatico.
PORT=3000
NODE_ENV=development

# Banco MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-esta-senha
DB_NAME=xevrak

# Segredo do token JWT. Gere um novo em producao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_HOURS=24

# Origens liberadas no CORS, separadas por virgula.
# Inclua o dominio do site quando ele estiver no ar.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Twitch (usado pela integracao de catalogo da API). Opcional.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
